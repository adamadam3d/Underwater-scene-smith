  "tour": [
    {
      "title": "Welcome to SceneSmith",
      "description": "SceneSmith is an agentic system for generating simulation-ready indoor scenes from text prompts. This tour follows the multi-stage pipeline where specialized agents cooperate to design full house layouts, place furniture, and add small-scale details.",
      "nodeIds": [
        "file:README.md"
      ]
    },
    {
      "title": "The Generation Pipeline",
      "description": "The system orchestrates a series of agents (floor plan, furniture, wall, ceiling, and manipuland). This configuration defines the sequence and endpoints for the generative servers that power the 3D asset creation.",
      "nodeIds": [
        "file:configurations/experiment/indoor_scene_generation.yaml"
      ]
    },
    {
      "title": "Stage 1: Floor Plan Design",
      "description": "The Floor Plan Agent designs the architectural skeleton of the scene. It manages room placement, wall geometry, and openings like doors and windows, creating a valid architectural layout based on the text prompt.",
      "nodeIds": [
        "file:scenesmith/floor_plan_agents/stateful_floor_plan_agent.py"
      ],
      "languageLesson": "In SceneSmith, the 'floor_plan' stage is the foundation. It uses procedural generation to turn abstract room requirements into a 3D architectural mesh."
    },
    {
      "title": "Stage 2: Furniture Placement",
      "description": "Once the layout is ready, the Furniture Agent takes over. It identifies functional zones and places primary objects (tables, chairs, cabinets). It balances aesthetic arrangement with physical constraints like reachability and clearance.",
      "nodeIds": [
        "file:scenesmith/furniture_agents/stateful_furniture_agent.py"
      ]
    },
    {
      "title": "Stage 3: Wall & Ceiling Accents",
      "description": "Decorative and functional secondary items are added next. The Wall Agent manages items like mirrors and artwork, while the Ceiling Agent places lighting fixtures, ensuring they are logically aligned with the furniture layout.",
      "nodeIds": [
        "file:scenesmith/wall_agents/stateful_wall_agent.py",
        "file:scenesmith/ceiling_agents/stateful_ceiling_agent.py"
      ]
    },
    {
      "title": "Stage 4: Manipuland Arrangement",
      "description": "The final placement stage focuses on 'manipulands'—small objects like fruits, books, or electronics. This agent identifies support surfaces on furniture and arranges these items to make the scene feel 'lived-in' and ready for robot interaction.",
      "nodeIds": [
        "file:scenesmith/manipuland_agents/stateful_manipuland_agent.py"
      ]
    },
    {
      "title": "Generative 3D Asset Creation",
      "description": "A core innovation of SceneSmith is on-demand asset generation. If an object isn't in the library, this server uses image-to-3D models (like SAM3D or Hunyuan3D) to generate a custom 3D mesh for the agent's specific needs.",
      "nodeIds": [
        "file:scenesmith/agent_utils/geometry_generation_server/geometry_generation.py"
      ],
      "languageLesson": "Generative agents use 'VLM' (Vision-Language Models) to analyze 2D renders and ensure the generated 3D assets match the requested style and scale."
    },
    {
      "title": "Simulation Readiness",
      "description": "To be useful for robotics, scenes must be more than just meshes. This module generates Drake-compatible SDF files, including physical properties like mass, inertia, and friction, ensuring the scene is ready for physics-based simulation.",
      "nodeIds": [
        "file:scenesmith/agent_utils/sdf_generator.py"
      ]
    },
    {
      "title": "Robot Task Evaluation",
      "description": "Finally, SceneSmith includes a loop for verifying task success. The Validator Agent uses visual and geometric checks to confirm if a robot can successfully perform tasks (like 'place fruit on table') within the generated environment.",
      "nodeIds": [
        "file:scenesmith/robot_eval/success_validation/validator_agent.py"
      ]
    }
  ]
}